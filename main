                  </div>
                  {selectedLocation.id === loc.id && <div className="w-2 h-2 bg-white rounded-full animate-pulse mt-2"></div>}
                </div>
              </div>
            ))}
          </div>
          <div className="p-6 bg-slate-900 text-white text-center">
             <p className="text-xs text-slate-400 uppercase font-bold tracking-widest mb-2">Global Support</p>
             <p className="font-mono text-lg">+1 (800) KIMCHI-KM</p>
